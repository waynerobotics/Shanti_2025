<?xml version="1.0"?>

<robot name="shanti" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Define robot constants in meters-->
  <xacro:property name="base_width" value="0.5" />
  <xacro:property name="base_length" value="0.9" />
  <xacro:property name="base_height" value="0.4" />

  <xacro:property name="wheel_radius" value="0.1016" />
  <xacro:property name="wheel_width" value="0.0762" />
  <xacro:property name="wheel_ygap" value="0.025" />
  <xacro:property name="wheel_zoff" value="0.21" />
  <xacro:property name="wheel_xoff" value="0.2921" />

  <xacro:property name="caster_xoff" value="0.16" />
  <xacro:property name="caster_radius" value="0.1" />

  <xacro:property name="lidar_radius" value="0.1" />
  <xacro:property name="lidar_length" value="0.08" />

  <xacro:property name="imu_length" value="0.1" />
  <xacro:property name="imu_width" value="0.1" />
  <xacro:property name="imu_height" value="0.05" />

  <xacro:property name="camera_length" value="0.1" />
  <xacro:property name="camera_width" value="0.05" />
  <xacro:property name="camera_height" value="0.1" />
  <xacro:property name="camera_xoff" value="0" />

  <xacro:property name="gps_length" value="0.1" />
  <xacro:property name="gps_width" value="0.1" />
  <xacro:property name="gps_height" value="0.1" />

  <xacro:include filename="$(find shanti_base)/description/inertia/inertial_macros.xacro" />
  <xacro:include filename="$(find shanti_base)/description/ros2_control/ros2_control_caster.xacro" />

  <xacro:include filename="$(find shanti_base)/description/sensors/lidar.xacro" />
  <xacro:include filename="$(find shanti_base)/description/sensors/imu.xacro" />
  <xacro:include filename="$(find shanti_base)/description/sensors/camera.xacro" />

  <xacro:include filename="$(find shanti_base)/description/wheels/diff_wheel.xacro" />
  <xacro:include filename="$(find shanti_base)/description/wheels/caster_wheel.xacro" />
  
  <!-- Robot Base -->
<link name="base_link">
  <visual>
    <geometry>
      <box size="${base_length} ${base_width} ${base_height}" />
    </geometry>
    <material name="Cyan">
      <color rgba="0 1.0 1.0 1.0" />
    </material>
  </visual>

  <xacro:inertial_box mass="0.1" x="${base_length}" y="${base_width}" z="${base_height}">
    <origin xyz="0 0 0" rpy="${pi/2} 0 ${pi/2}"/>
  </xacro:inertial_box>
</link>


  <!-- Robot Footprint -->
  <link name="base_footprint" />
  <joint name="base_joint" type="fixed">
    <parent link="base_link" />
    <child link="base_footprint" />
    <origin xyz="0.0 0.0 ${-(wheel_radius+wheel_zoff)}" rpy="0 0 0" />
  </joint>

 <!-- Wheels  -->
  <xacro:diff_wheel prefix="drivewhl_l1" x_reflect="-1" y_reflect="1"/>
  <xacro:diff_wheel prefix="drivewhl_r1" x_reflect="-1" y_reflect="-1" />
  <xacro:caster_wheel prefix="caster_front" x_reflect="1" />


<link name="gps_link">
  <visual>
    <geometry>
      <box size="${gps_length} ${gps_width} ${gps_height}" />
    </geometry>
    <material name="Green">
      <color rgba="0 1.0 0 1.0" />
    </material>
  </visual>

  <xacro:inertial_box mass="0.1" x="${gps_length}" y="${gps_width}" z="${gps_height}">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:inertial_box>

</link>


<joint name="gps_joint" type="fixed">
  <parent link="base_link"/>
  <child link ="gps_link"/>
  <origin xyz="0.1 0 ${base_height/2 + gps_height/2}"/>
</joint>


<gazebo reference="gps_link">
  <sensor name="shanti_gps" type="gps">
    <always_on>true</always_on>
    <update_rate>1</update_rate>
    <pose>0 0 0 0 0 0</pose>
    <gps>
      <position_sensing>
        <horizontal>
          <noise type="gaussian">
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </horizontal>
        <vertical>
          <noise type="gaussian">
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </vertical>
      </position_sensing>
    </gps>
  </sensor>

  <topic>/gps/fix</topic>
  <gz_frame_id>gps_link</gz_frame_id>

</gazebo>
</robot>
