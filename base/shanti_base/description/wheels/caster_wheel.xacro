<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="caster_wheel">
    <!-- Caster Wheel Description -->

  <xacro:macro name="caster_wheel" params="prefix x_reflect">
        <link name="${prefix}_wheel">
            <visual>
                <geometry>
                    <sphere radius="${caster_radius}"/>
                </geometry>
                <material name="white"/>
            </visual>
            <collision>
                <geometry>
                    <sphere radius="${caster_radius}"/>
                </geometry>
            </collision>
            <xacro:inertial_sphere mass="10" radius="${caster_radius}">
                <origin xyz="0 0 0" rpy="0 0 0"/>
            </xacro:inertial_sphere>
        </link>

        <joint name="${prefix}_joint" type="fixed">
            <parent link="base_link"/>
            <child link="${prefix}_wheel"/>
            <origin xyz="${x_reflect * base_width/2} 0 ${-(base_height/2)}" rpy="0 0 0"/>
        </joint>

        <gazebo reference="${prefix}_wheel">
            <material>Gazebo/Blue</material>
            <mu1 value="0.01"/>
            <mu2 value="0.01"/>
        </gazebo>

    </xacro:macro>
</robot>


